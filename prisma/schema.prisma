// ---- Soporte de TI: mantenimientos y reportes de equipo ----
// Evidencia para ISO 9001: de cada mantenimiento queda quién lo hizo, cuándo se
// programó, cuándo se hizo de verdad, qué se encontró y fotos.

enum MaintenanceKind {
  preventive
  corrective
}

enum MaintenanceStatus {
  scheduled
  done
  cancelled
}

/// Equipo sobre el que se trabaja. Hoy solo hay laptops y celulares dados de alta.
enum EquipmentKind {
  laptop
  phone
}

model Maintenance {
  id            String            @id @default(cuid()) @map("id")
  kind          MaintenanceKind   @map("kind")
  status        MaintenanceStatus @default(scheduled) @map("status")
  equipmentKind EquipmentKind     @map("equipment_kind")
  laptopId      String?           @map("laptop_id")
  laptop        Laptop?           @relation(fields: [laptopId], references: [id], onDelete: Cascade)
  phoneId       String?           @map("phone_id")
  phone         Phone?            @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  /// Qué se va a hacer (al programar) o qué se hizo (al cerrar).
  description   String            @map("description")
  /// Lo que se encontró al revisar el equipo.
  findings      String?           @map("findings")
  /// A quién se le hizo: el responsable del equipo EN ESE MOMENTO. Se congela
  /// al registrarlo porque el equipo cambia de manos y la evidencia de ISO
  /// tiene que seguir diciendo a quién se le atendió aquel día.
  recipientName String?           @map("recipient_name")
  scheduledFor  DateTime          @map("scheduled_for")
  performedAt   DateTime?         @map("performed_at")
  /// Fotos de evidencia: [{ url, publicId }].
  photos        Json?             @map("photos")
  technicianId  String            @map("technician_id")
  technician    User              @relation("MaintenanceTechnician", fields: [technicianId], references: [id], onDelete: Cascade)
  /// Reporte que originó el mantenimiento, si nació de uno.
  ticketId      String?           @map("ticket_id")
  ticket        SupportTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([scheduledFor])
  @@map("maintenances")
}

// ---- App: reloj checador (fase 1: solo registro) ----

/// Las cuatro marcas de una jornada.
enum TimeClockMark {
  clock_in
  lunch_start
  lunch_end
  clock_out
}

/// Cómo salió la lectura de ubicación al marcar. Nunca bloquea la checada:
/// que el colaborador no dé permiso o que el GPS falle se registra y ya.
enum GeoStatus {
  granted
  denied
  unavailable
}

/// Qué hace una corrección con la marca original.
enum CorrectionKind {
  /// Cambia la hora de una marca que se registró mal.
  adjust
  /// Anula una marca que no debió existir.
  void
  /// Agrega una marca que faltó. No corrige a ninguna: nace suelta.
  add
}

/// Una checada. Es INMUTABLE: no se edita ni se borra nunca — por eso no
/// tiene updatedAt. Una corrección (fase 2) será un renglón nuevo que apunte
/// a este. La hora la pone siempre el servidor: el navegador dice qué marca
/// hace, jamás cuándo.
model TimeClockEntry {
  id        String        @id @default(cuid()) @map("id")
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mark      TimeClockMark @map("mark")
  markedAt  DateTime      @default(now()) @map("marked_at")

  /// Jornada a la que pertenece, anclada al día en que EMPIEZA. Un turno de
  /// 22:00 a 06:00 deja sus cuatro marcas en la misma fecha aunque el reloj
  /// cruce la medianoche.
  workDate  DateTime      @db.Date @map("work_date")

  /// Señales de evidencia. Ninguna prueba nada sola; sirven cruzadas.
  ipAddress String?       @map("ip_address")
  userAgent String?       @map("user_agent")
  /// Identificador del navegador, para notar dos personas en el mismo equipo.
  deviceId  String?       @map("device_id")
  latitude  Float?        @map("latitude")
  longitude Float?        @map("longitude")
  /// Margen de error que reportó el GPS, en metros.
  accuracyM Float?        @map("accuracy_m")
  /// Distancia a la oficina en metros, calculada en el servidor.
  distanceM Float?        @map("distance_m")
  geoStatus GeoStatus?    @map("geo_status")

  /// Lo que escribe el colaborador. Obligatorio al llegar con retardo o
  /// pasarse de la comida: sin él, el servidor rechaza la marca.
  reason    String?       @map("reason")

  /// Banderas calculadas al momento de marcar. Se guardan y no se recalculan
  /// después, porque la configuración de la oficina cambia con el tiempo y el
  /// registro tiene que decir qué se sabía aquel día.
  outsideGeofence Boolean? @map("outside_geofence")
  foreignNetwork  Boolean? @map("foreign_network")
  /// Otro colaborador marcó desde este mismo equipo en la misma jornada.
  sharedDevice    Boolean? @map("shared_device")

  /// Una corrección de dirección. La original NUNCA se toca: esta apunta a
  /// ella y en pantalla se ven las dos.
  correctionKind   CorrectionKind? @map("correction_kind")
  correctionOfId   String?         @map("correction_of_id")
  correctionOf     TimeClockEntry? @relation("EntryCorrection", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections      TimeClockEntry[] @relation("EntryCorrection")
  correctedById    String?         @map("corrected_by_id")
  correctedBy      User?           @relation("TimeClockCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  correctionReason String?         @map("correction_reason")

  createdAt DateTime      @default(now()) @map("created_at")

  incidents TimeClockIncident[]

  @@index([userId, workDate])
  @@index([workDate])
  @@map("time_clock_entries")
}

/// Horario de un colaborador para un día de la semana. Lo captura RH.
/// Que no exista renglón para un día significa que ese día no labora.
model WorkSchedule {
  id     String @id @default(cuid()) @map("id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 0 = domingo … 6 = sábado, en la zona de la empresa.
  weekday Int @map("weekday")

  /// Minutos desde la medianoche. Se guardan así y no como hora para que el
  /// cálculo no arrastre fechas ni zonas: 9:00 son 540, 22:00 son 1320.
  startMinute Int @map("start_minute")
  /// Si es menor o igual al de entrada, el turno cruza la medianoche.
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, weekday])
  @@map("work_schedules")
}

/// Lo que el checador le anota a un colaborador.
enum IncidentKind {
  /// Llegó pasada la tolerancia.
  retardo
  /// Tres retardos juntos, o lo que RH determine.
  falta
  /// Se pasó de la hora de comida.
  comida_larga
  /// Cerró la jornada sin marcar comida. No es falta: la revisa RH.
  sin_comida
}

/// Una anotación con fecha de caducidad.
///
/// Se materializa en vez de calcularse al vuelo porque los retardos "se
/// consumen" al volverse falta: sin dejar constancia de cuáles se comió cada
/// falta, el cuarto retardo dispararía otra falta de inmediato.
model TimeClockIncident {
  id     String       @id @default(cuid()) @map("id")
  userId String       @map("user_id")
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   IncidentKind @map("kind")

  /// Jornada que la originó.
  workDate DateTime @db.Date @map("work_date")
  /// Deja de contar en esta fecha. Ventana rodante de 30 días.
  expiresOn DateTime @db.Date @map("expires_on")

  /// La checada que la disparó, cuando nació de una.
  entryId String?         @map("entry_id")
  entry   TimeClockEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  /// La falta que se comió este retardo. Mientras sea null, el retardo cuenta.
  consumedById String?             @map("consumed_by_id")
  consumedBy   TimeClockIncident?  @relation("FaltaConsume", fields: [consumedById], references: [id], onDelete: SetNull)
  consumed     TimeClockIncident[] @relation("FaltaConsume")

  /// Cuántos minutos tarde, para que RH no tenga que restar horas.
  minutesLate Int? @map("minutes_late")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresOn])
  @@map("time_clock_incidents")
}

/// Día festivo del checador. Lo administra solo dirección.
///
/// En un festivo se puede marcar igual — hay quien trabaja —, pero la jornada
/// no se juzga: no hay retardo, ni motivo obligatorio, ni incidencias.
model Holiday {
  id        String   @id @default(cuid()) @map("id")
  /// DATE a medianoche UTC, igual que work_date, para compararlos directo.
  date      DateTime @unique @db.Date @map("date")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

/// Días programados que cambian cómo se juzga la jornada de UNA persona.
enum LeaveKind {
  vacaciones
  home_office
  incapacidad
  permiso
}

/// Periodo programado para un colaborador: vacaciones, home office,
/// incapacidad o permiso.
///
/// Los cuatro dejan marcar desde donde sea: quien está de home office no está
/// en la oficina, y quien está de vacaciones tampoco. Solo el home office
/// sigue siendo día de trabajo, así que es el único al que se le cuenta
/// retardo contra su horario.
model TimeClockLeave {
  id     String    @id @default(cuid()) @map("id")
  userId String    @map("user_id")
  user   User      @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind   LeaveKind @map("kind")

  /// Ambas inclusive, como DATE: se comparan directo contra work_date.
  startDate DateTime @db.Date @map("start_date")
  endDate   DateTime @db.Date @map("end_date")

  note String? @map("note")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("LeaveAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, startDate, endDate])
  @@map("time_clock_leaves")
}

// ---- App: prospección de proveedores (CRM de transportistas) ----

/// Cómo se consiguió el contacto del transportista.
enum ProspectSource {
  carretera
  whatsapp
  internet
  calle
}

/// Qué tipo de rutas cubre.
enum ProspectCoverage {
  nacional
  internacional
  ambas
}

/// Etapa del prospecto. Avanza de pendiente a listo para operar; descartado se
/// puede marcar desde cualquier etapa y exige un motivo.
enum ProspectStatus {
  pendiente
  prospectando
  negociando
  en_alta
  listo
  descartado
}

/// Transportista en prospección, antes de darlo de alta como proveedor.
model ProviderProspect {
  id             String            @id @default(cuid()) @map("id")
  commercialName String            @map("commercial_name")
  contactName    String?           @map("contact_name")
  phone          String?           @map("phone")
  email          String?           @map("email")
  website        String?           @map("website")
  source         ProspectSource?   @map("source")
  coverage       ProspectCoverage? @map("coverage")
  status         ProspectStatus    @default(pendiente) @map("status")

  /// Los usa hoy en su Excel: la razón social hace falta al darlo de alta y la
  /// ciudad es lo que más se busca para encontrar transportista por zona.
  legalName   String?   @map("legal_name")
  city        String?   @map("city")
  contactedOn DateTime? @db.Date @map("contacted_on")
  notes       String?   @map("notes")

  /// Por qué se descartó. Obligatorio al descartar; se conserva si vuelve a
  /// otra etapa, para saber qué había pasado antes.
  discardReason String? @map("discard_reason")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ProspectAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  onboarding  ProviderOnboarding?

  @@index([status])
  @@map("provider_prospects")
}

enum TicketStatus {
  open
  in_progress
  resolved
}

model SupportTicket {
  id            String        @id @default(cuid()) @map("id")
  title         String        @map("title")
  description   String        @map("description")
  status        TicketStatus  @default(open) @map("status")
  equipmentKind EquipmentKind? @map("equipment_kind")
  laptopId      String?       @map("laptop_id")
  laptop        Laptop?       @relation(fields: [laptopId], references: [id], onDelete: SetNull)
  phoneId       String?       @map("phone_id")
  phone         Phone?        @relation(fields: [phoneId], references: [id], onDelete: SetNull)
  reporterId    String        @map("reporter_id")
  reporter      User          @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  /// Cómo se resolvió; queda como evidencia junto al mantenimiento.
  resolution    String?       @map("resolution")
  resolvedAt    DateTime?     @map("resolved_at")
  maintenances  Maintenance[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@map("support_tickets")
}

// ---- Alta de proveedores: los documentos y el contrato de cada transportista
// que Finanzas va dando de alta. Sustituye su Excel "Proceso de alta".

/// Cada documento del expediente: pendiente, recibido o no aplica (en el
/// Excel: vacío, X, N/A).
enum OnboardingDocStatus {
  pending
  received
  not_applicable
}

/// En qué va el contrato. Son los textos que Finanzas usa en su columna de
/// comentarios, ya como estado.
enum ContractStatus {
  not_requested
  requested_legal
  sent_to_provider
  received_signed
  docs_updated
}

model ProviderOnboarding {
  id             String  @id @default(cuid()) @map("id")
  legalName      String  @map("legal_name")
  commercialName String  @map("commercial_name")
  /// De qué prospecto nació, si vino de Prospección.
  prospectId     String?           @unique @map("prospect_id")
  prospect       ProviderProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  startedOn DateTime @db.Date @map("started_on")

  // Expediente, en el orden del Excel.
  docAltaJtp        OnboardingDocStatus @default(pending) @map("doc_alta_jtp")
  docBilling        OnboardingDocStatus @default(pending) @map("doc_billing")
  docTaxCertificate OnboardingDocStatus @default(pending) @map("doc_tax_certificate")
  docOpinion        OnboardingDocStatus @default(pending) @map("doc_opinion")
  docAddressProof   OnboardingDocStatus @default(pending) @map("doc_address_proof")
  docIne            OnboardingDocStatus @default(pending) @map("doc_ine")
  docArticles       OnboardingDocStatus @default(pending) @map("doc_articles")
  docPower          OnboardingDocStatus @default(pending) @map("doc_power")

  /// Se llena sola la primera vez que el expediente queda completo; se puede corregir.
  completedOn       DateTime? @db.Date @map("completed_on")
  altaAuthorizedBy  String?   @map("alta_authorized_by")

  contractStatus       ContractStatus @default(not_requested) @map("contract_status")
  legalRequestedOn     DateTime? @db.Date @map("legal_requested_on")
  legalReceivedOn      DateTime? @db.Date @map("legal_received_on")
  sentToProviderOn     DateTime? @db.Date @map("sent_to_provider_on")
  signedReceivedOn     DateTime? @db.Date @map("signed_received_on")
  contractAuthorizedBy String?   @map("contract_authorized_by")

  notes           String? @map("notes")
  purchasingNotes String? @map("purchasing_notes")

  /// Detenido: los renglones morados del Excel ("ya no contesta", "empresa
  /// fantasma"…). Con motivo obligatorio; se puede reactivar.
  onHoldSince DateTime? @db.Date @map("on_hold_since")
  holdReason  String?   @map("hold_reason")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("OnboardingAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([contractStatus])
  @@map("provider_onboardings")
}

// ---- CRM de clientes ----

/// Etapas del embudo de venta. perdido es una salida, no un avance.
enum ClientLeadStage {
  prospecto
  contactado
  cotizado
  negociacion
  ganado
  perdido
}

enum ClientLeadSource {
  referido
  llamada
  sitio_web
  redes_sociales
  expo
  cliente_actual
  otro
}

enum ClientLeadActivityType {
  llamada
  correo
  whatsapp
  reunion
  visita
  cotizacion
  nota
}

/// Empresa a la que se le quiere vender (prospecto de cliente).
model ClientLead {
  id               String            @id @default(cuid()) @map("id")
  companyName      String            @map("company_name")
  contactName      String?           @map("contact_name")
  position         String?           @map("position")
  phone            String?           @map("phone")
  email            String?           @map("email")
  city             String?           @map("city")
  /// Giro o industria del cliente.
  industry         String?           @map("industry")
  rfc              String?           @map("rfc")
  address          String?           @map("address")
  source           ClientLeadSource? @map("source")
  stage            ClientLeadStage   @default(prospecto) @map("stage")
  /// Venta mensual que se espera si se cierra, en pesos.
  estimatedMonthly Float?            @map("estimated_monthly")
  notes            String?           @map("notes")
  /// Por qué se perdió. Obligatorio al marcarlo perdido.
  lostReason       String?           @map("lost_reason")
  /// Próximo seguimiento: qué toca hacer y cuándo.
  nextAction       String?           @map("next_action")
  nextFollowUpOn   DateTime?         @db.Date @map("next_follow_up_on")
  ownerId          String?           @map("owner_id")
  owner            User?             @relation("ClientLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Cliente del catálogo en el que se convirtió (o al que corresponde).
  clientId         String?           @map("client_id")
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById      String?           @map("created_by_id")
  createdBy        User?             @relation("ClientLeadAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  activities       ClientLeadActivity[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUpOn])
  @@map("client_leads")
}

/// Llamada, correo, visita… lo que se hizo con el prospecto, en orden.
model ClientLeadActivity {
  id         String                 @id @default(cuid()) @map("id")
  leadId     String                 @map("lead_id")
  lead       ClientLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       ClientLeadActivityType @map("type")
  summary    String                 @map("summary")
  occurredOn DateTime               @db.Date @map("occurred_on")
  authorId   String?                @map("author_id")
  author     User?                  @relation("ClientLeadActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([leadId, occurredOn])
  @@map("client_lead_activities")
}

// ---- Administración: cobranza, pagos, bancos y gastos ----

enum Currency {
  MXN
  USD
}

/// Cuenta por cobrar (factura a un cliente) o por pagar (factura de un proveedor).
enum BillingKind {
  receivable
  payable
}

/// Método de pago del CFDI: una sola exhibición o en parcialidades/diferido.
enum CfdiPaymentMethod {
  PUE
  PPD
}

/// Factura emitida a un cliente (receivable) o recibida de un proveedor
/// (payable). El saldo sale de restar sus pagos al total.
model BillingDocument {
  id            String            @id @default(cuid()) @map("id")
  kind          BillingKind       @map("kind")
  /// Cliente del catálogo (solo cuentas por cobrar).
  clientId      String?           @map("client_id")
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Nombre de la contraparte tal como va en la factura (cliente o proveedor).
  partyName     String            @map("party_name")
  partyRfc      String?           @map("party_rfc")
  series        String?           @map("series")
  /// Vacío mientras es borrador: el folio llega al emitir la factura.
  folio         String?           @map("folio")
  /// Borrador armado desde un embarque: todavía no es factura, no cuenta en
  /// saldos ni acepta pagos.
  draft         Boolean           @default(false) @map("draft")
  /// Embarque del que salió (facturar desde el embarque).
  shipmentId    String?           @map("shipment_id")
  shipment      Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  /// Foto de los datos de Carta Porte al armar el borrador (ruta, transportista,
  /// unidad y operador). Para el timbrado, cuando haya PAC.
  cartaPorte    Json?             @map("carta_porte")
  /// Folio fiscal (UUID) del CFDI.
  uuid          String?           @map("uuid")
  issueDate     DateTime          @db.Date @map("issue_date")
  dueDate       DateTime          @db.Date @map("due_date")
  currency      Currency          @default(MXN) @map("currency")
  /// Pesos por dólar el día de la factura (1 en pesos).
  exchangeRate  Float             @default(1) @map("exchange_rate")
  subtotal      Float             @map("subtotal")
  ivaRate       Float             @default(0.16) @map("iva_rate")
  iva           Float             @map("iva")
  /// Retención de IVA (4 % en autotransporte de carga a personas morales).
  ivaWithheld   Float             @default(0) @map("iva_withheld")
  /// Retención de ISR (1.25 % de transportistas en RESICO). Llega del XML.
  isrWithheld   Float             @default(0) @map("isr_withheld")
  total         Float             @map("total")
  paymentMethod CfdiPaymentMethod @default(PPD) @map("payment_method")
  concept       String?           @map("concept")
  /// ECO o referencia de los embarques que cubre.
  reference     String?           @map("reference")
  notes         String?           @map("notes")
  /// De dónde viene: capturada desde Alegra, manual o timbrada en la plataforma.
  source        String            @default("manual") @map("source")
  cancelledAt   DateTime?         @map("cancelled_at")
  cancelReason  String?           @map("cancel_reason")
  createdById   String?           @map("created_by_id")
  createdBy     User?             @relation("BillingDocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  payments      BillingPayment[]
  creditNotes   BillingCreditNote[]
  attachments   BillingAttachment[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([kind, series, folio, partyName])
  @@index([kind, dueDate])
  @@index([clientId])
  @@index([shipmentId])
  @@map("billing_documents")
}

/// Cobro o pago aplicado a una factura. Crea su movimiento en el banco.
model BillingPayment {
  id            String          @id @default(cuid()) @map("id")
  documentId    String          @map("document_id")
  document      BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paidOn        DateTime        @db.Date @map("paid_on")
  /// Monto aplicado, en la moneda de la factura.
  amount        Float           @map("amount")
  bankAccountId String          @map("bank_account_id")
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  /// Monto que entró o salió de la cuenta, en la moneda de la cuenta.
  bankAmount    Float           @map("bank_amount")
  exchangeRate  Float           @default(1) @map("exchange_rate")
  /// Forma de pago del SAT (03 transferencia, 01 efectivo, 02 cheque…).
  paymentForm   String?         @map("payment_form")
  reference     String?         @map("reference")
  /// Cuando una sola transferencia paga varias facturas: el movimiento de
  /// banco es uno y los cobros cuelgan de él.
  batchMovementId String?       @map("batch_movement_id")
  batchMovement   BankMovement? @relation("BatchPayments", fields: [batchMovementId], references: [id], onDelete: Cascade)
  notes         String?         @map("notes")
  createdById   String?         @map("created_by_id")
  createdBy     User?           @relation("BillingPaymentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  movement      BankMovement?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([documentId])
  @@index([batchMovementId])
  @@map("billing_payments")
}
/// Nota de crédito (CFDI de egreso) sobre una factura: baja su saldo sin
/// mover el banco (descuento, devolución, bonificación).
model BillingCreditNote {
  id          String              @id @default(cuid()) @map("id")
  documentId  String              @map("document_id")
  document    BillingDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  issueDate   DateTime            @db.Date @map("issue_date")
  series      String?             @map("series")
  folio       String?             @map("folio")
  uuid        String?             @map("uuid")
  subtotal    Float               @map("subtotal")
  iva         Float               @default(0) @map("iva")
  ivaWithheld Float               @default(0) @map("iva_withheld")
  isrWithheld Float               @default(0) @map("isr_withheld")
  /// Lo que se le quita al saldo de la factura, en su moneda.
  total       Float               @map("total")
  reason      String              @map("reason")
  attachments BillingAttachment[]
  createdById String?             @map("created_by_id")
  createdBy   User?               @relation("BillingCreditNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@map("billing_credit_notes")
}

/// PDF o XML de una factura. El archivo vive en Cloudinary como privado y
/// solo se descarga a través de la plataforma.
model BillingAttachment {
  id          String           @id @default(cuid()) @map("id")
  /// Vacío mientras se sube y todavía no se guarda la factura.
  documentId  String?          @map("document_id")
  document    BillingDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// "xml" o "pdf".
  kind        String           @map("kind")
  fileName    String           @map("file_name")
  size        Int              @map("size")
  storageId   String           @map("storage_id")
  /// Lo que se leyó del XML (CFDI): folio, UUID, importes, emisor y receptor.
  cfdi        Json?            @map("cfdi")
  /// Si es el PDF o XML de una nota de crédito (y no de la factura misma).
  creditNoteId String?           @map("credit_note_id")
  creditNote   BillingCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("BillingAttachmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([documentId])
  @@map("billing_attachments")
}


model BankAccount {
  id               String           @id @default(cuid()) @map("id")
  name             String           @map("name")
  bank             String?          @map("bank")
  /// Últimos dígitos o CLABE, para identificarla.
  accountNumber    String?          @map("account_number")
  currency         Currency         @default(MXN) @map("currency")
  initialBalance   Float            @default(0) @map("initial_balance")
  initialBalanceOn DateTime         @db.Date @map("initial_balance_on")
  active           Boolean          @default(true) @map("active")
  movements        BankMovement[]
  payments         BillingPayment[]
  expenses         Expense[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

/// Movimiento de una cuenta: lo crean los cobros, pagos y gastos, o se
/// captura a mano (comisiones, intereses, traspasos). Positivo entra, negativo sale.
model BankMovement {
  id            String          @id @default(cuid()) @map("id")
  bankAccountId String          @map("bank_account_id")
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date @map("date")
  amount        Float           @map("amount")
  concept       String          @map("concept")
  reference     String?         @map("reference")
  /// Ya se comparó contra el estado de cuenta del banco.
  reconciled    Boolean         @default(false) @map("reconciled")
  paymentId     String?         @unique @map("payment_id")
  payment       BillingPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  batchPayments BillingPayment[] @relation("BatchPayments")
  expenseId     String?         @unique @map("expense_id")
  expense       Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdById   String?         @map("created_by_id")
  createdBy     User?           @relation("BankMovementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([bankAccountId, date])
  @@map("bank_movements")
}

/// Gasto de operación de la empresa (renta, servicios, nómina, casetas…).
model Expense {
  id            String       @id @default(cuid()) @map("id")
  date          DateTime     @db.Date @map("date")
  category      String       @map("category")
  providerName  String?      @map("provider_name")
  description   String       @map("description")
  currency      Currency     @default(MXN) @map("currency")
  exchangeRate  Float        @default(1) @map("exchange_rate")
  subtotal      Float        @map("subtotal")
  iva           Float        @default(0) @map("iva")
  total         Float        @map("total")
  /// Folio fiscal si el gasto tiene factura.
  uuid          String?      @map("uuid")
  bankAccountId String?      @map("bank_account_id")
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  notes         String?      @map("notes")
  createdById   String?      @map("created_by_id")
  createdBy     User?        @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  movement      BankMovement?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([date])
  @@map("expenses")
}

// ---- Expediente de Carta Porte del transportista ----

/// Tracto o camión (motriz) o remolque del transportista, con lo que pide la
/// Carta Porte 3.1 en el nodo Autotransporte.
model CarrierVehicle {
  id             String   @id @default(cuid()) @map("id")
  carrierId      String   @map("carrier_id")
  carrier        User     @relation("CarrierFleet", fields: [carrierId], references: [id], onDelete: Cascade)
  /// "motriz" (tracto o camión) o "remolque".
  kind           String   @map("kind")
  /// Número económico o nombre con el que lo identifican.
  label          String?  @map("label")
  plates         String   @map("plates")
  year           Int?     @map("year")
  /// c_ConfigAutotransporte (solo motriz).
  vehicleConfig  String?  @map("vehicle_config")
  /// c_TipoPermiso y número del permiso de la SCT (solo motriz).
  sctPermitType  String?  @map("sct_permit_type")
  sctPermitNumber String? @map("sct_permit_number")
  /// Peso bruto vehicular en toneladas (solo motriz).
  grossWeightTons Float?  @map("gross_weight_tons")
  /// Seguro de responsabilidad civil (solo motriz).
  insurer        String?  @map("insurer")
  policyNumber   String?  @map("policy_number")
  /// c_SubTipoRem (solo remolque).
  trailerSubtype String?  @map("trailer_subtype")
  active         Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([carrierId])
  @@map("carrier_vehicles")
}

/// Operador (chofer) del transportista: la Carta Porte pide su RFC y licencia.
model CarrierOperator {
  id            String   @id @default(cuid()) @map("id")
  carrierId     String   @map("carrier_id")
  carrier       User     @relation("CarrierOperators", fields: [carrierId], references: [id], onDelete: Cascade)
  name          String   @map("name")
  rfc           String?  @map("rfc")
  licenseNumber String?  @map("license_number")
  phone         String?  @map("phone")
  active        Boolean  @default(true) @map("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([carrierId])
  @@map("carrier_operators")
}
