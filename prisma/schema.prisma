// Prisma schema - BD en snake_case (tablas y columnas).
// Ver /docs/conventions.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Better Auth (tablas mapeadas a snake_case) ----
// User roles stored in English: admin, carrier, collaborator, vendor, developer

enum UserRole {
  admin
  carrier
  collaborator
  vendor
  developer
}

enum TaskStatus {
  pending
  in_progress
  completed
}

model User {
  id            String         @id @default(cuid()) @map("id")
  name          String         @map("name")
  email         String         @unique @map("email")
  position      String?        @map("position")
  emailVerified Boolean        @map("email_verified")
  image         String?        @map("image")
  birthDate     DateTime?      @map("birth_date")
  vendorNotes   String?        @map("vendor_notes")
  carrierNotes  String?        @map("carrier_notes")
  role          UserRole       @default(collaborator) @map("role")
  canEditTarget Boolean        @default(true) @map("can_edit_target")
  canEditRoutes  Boolean        @default(false) @map("can_edit_routes")
  canAddRoutes   Boolean        @default(true) @map("can_add_routes")
  canEditAcceptedQuotes Boolean  @default(false) @map("can_edit_accepted_quotes")
  /// Lectura de la bitácora de mantenimientos: la evidencia que revisa calidad
  /// para ISO 9001. Programarlos y cerrarlos sigue siendo cosa de soporte TI.
  canViewMaintenance Boolean    @default(false) @map("can_view_maintenance")
  /// Acceso a la pantalla de correos de prueba, para revisar cómo llegan las
  /// plantillas antes de publicar algo.
  canViewEmailDemos Boolean     @default(false) @map("can_view_email_demos")
  /// Cambiar el correo con el que un colaborador inicia sesión. Va suelto y no
  /// pegado a canUpdateEmployees porque no es editar la ficha: le cierra la
  /// sesión y le cambia el acceso. Lo lleva RH junto con dirección y soporte TI.
  canChangeEmployeeEmail Boolean @default(false) @map("can_change_employee_email")
  /// Ver el registro del checador de TODOS. Marcar lo propio no pide permiso.
  canViewTimeClock  Boolean       @default(false) @map("can_view_time_clock")
  /// Capturar los horarios de los colaboradores. Lo lleva RH.
  canManageSchedules Boolean      @default(false) @map("can_manage_schedules")
  /// Ver los KPIs de cotizaciones (tasa de cierre, montos, por colaborador).
  canViewQuoteKpis   Boolean      @default(false) @map("can_view_quote_kpis")
  canViewMessages   Boolean       @default(false) @map("can_view_messages")
  canViewIdeas      Boolean       @default(false) @map("can_view_ideas")
  canViewRoutes     Boolean       @default(false) @map("can_view_routes")
  canViewRouteLogs  Boolean       @default(false) @map("can_view_route_logs")
  canViewUnitTypes  Boolean       @default(false) @map("can_view_unit_types")
  canViewQuotes     Boolean       @default(false) @map("can_view_quotes")
  canViewProviders  Boolean       @default(false) @map("can_view_providers")
  canViewProviderProspects   Boolean @default(false) @map("can_view_provider_prospects")
  canCreateProviderProspects Boolean @default(false) @map("can_create_provider_prospects")
  canUpdateProviderProspects Boolean @default(false) @map("can_update_provider_prospects")
  canDeleteProviderProspects Boolean @default(false) @map("can_delete_provider_prospects")
  canViewProviderOnboardings   Boolean @default(false) @map("can_view_provider_onboardings")
  canCreateProviderOnboardings Boolean @default(false) @map("can_create_provider_onboardings")
  canUpdateProviderOnboardings Boolean @default(false) @map("can_update_provider_onboardings")
  canDeleteProviderOnboardings Boolean @default(false) @map("can_delete_provider_onboardings")
  canViewClientLeads   Boolean @default(false) @map("can_view_client_leads")
  canCreateClientLeads Boolean @default(false) @map("can_create_client_leads")
  canUpdateClientLeads Boolean @default(false) @map("can_update_client_leads")
  canDeleteClientLeads Boolean @default(false) @map("can_delete_client_leads")
  /// Administración: cuentas por cobrar y por pagar, bancos y gastos.
  canViewBilling   Boolean @default(false) @map("can_view_billing")
  canCreateBilling Boolean @default(false) @map("can_create_billing")
  canUpdateBilling Boolean @default(false) @map("can_update_billing")
  canDeleteBilling Boolean @default(false) @map("can_delete_billing")
  canViewClients    Boolean       @default(false) @map("can_view_clients")
  canViewEmployees  Boolean       @default(false) @map("can_view_employees")
  canViewVendors    Boolean       @default(false) @map("can_view_vendors")
  canViewLaptops    Boolean       @default(false) @map("can_view_laptops")
  canViewPhones     Boolean       @default(false) @map("can_view_phones")
  canViewEmails     Boolean       @default(false) @map("can_view_emails")
  canViewTasks      Boolean       @default(false) @map("can_view_tasks")
  canViewShipments  Boolean       @default(false) @map("can_view_shipments")
  canViewFinances   Boolean       @default(false) @map("can_view_finances")
  canViewMaritimeQuotes Boolean   @default(false) @map("can_view_maritime_quotes")
  canViewMural      Boolean       @default(false) @map("can_view_mural")
  canCreateMessages Boolean       @default(false) @map("can_create_messages")
  canCreateIdeas    Boolean       @default(false) @map("can_create_ideas")
  canCreateRoutes   Boolean       @default(false) @map("can_create_routes")
  canCreateRouteLogs Boolean      @default(false) @map("can_create_route_logs")
  canCreateUnitTypes Boolean      @default(false) @map("can_create_unit_types")
  canCreateQuotes   Boolean       @default(false) @map("can_create_quotes")
  canCreateProviders Boolean      @default(false) @map("can_create_providers")
  canCreateClients  Boolean       @default(false) @map("can_create_clients")
  canCreateEmployees Boolean      @default(false) @map("can_create_employees")
  canCreateVendors  Boolean       @default(false) @map("can_create_vendors")
  canCreateLaptops  Boolean       @default(false) @map("can_create_laptops")
  canCreatePhones   Boolean       @default(false) @map("can_create_phones")
  canCreateEmails   Boolean       @default(false) @map("can_create_emails")
  canCreateTasks    Boolean       @default(false) @map("can_create_tasks")
  canCreateShipments Boolean      @default(false) @map("can_create_shipments")
  canCreateFinances Boolean       @default(false) @map("can_create_finances")
  canCreateMaritimeQuotes Boolean @default(false) @map("can_create_maritime_quotes")
  canCreateMural    Boolean       @default(false) @map("can_create_mural")
  canUpdateMessages Boolean       @default(false) @map("can_update_messages")
  canUpdateIdeas    Boolean       @default(false) @map("can_update_ideas")
  canUpdateRoutes   Boolean       @default(false) @map("can_update_routes")
  /// Solo cambiar el estatus de una ruta (activa, pendiente, inactiva), sin editar el resto.
  canChangeRouteStatus Boolean    @default(false) @map("can_change_route_status")
  /// Recibe en campana y correo los avisos de Alta de proveedores.
  canReceiveOnboardingAlerts Boolean @default(false) @map("can_receive_onboarding_alerts")
  canUpdateRouteLogs Boolean      @default(false) @map("can_update_route_logs")
  canUpdateUnitTypes Boolean      @default(false) @map("can_update_unit_types")
  canUpdateQuotes   Boolean       @default(false) @map("can_update_quotes")
  canUpdateProviders Boolean      @default(false) @map("can_update_providers")
  canUpdateClients  Boolean       @default(false) @map("can_update_clients")
  canUpdateEmployees Boolean      @default(false) @map("can_update_employees")
  canUpdateVendors  Boolean       @default(false) @map("can_update_vendors")
  canUpdateLaptops  Boolean       @default(false) @map("can_update_laptops")
  canUpdatePhones   Boolean       @default(false) @map("can_update_phones")
  canUpdateEmails   Boolean       @default(false) @map("can_update_emails")
  canUpdateTasks    Boolean       @default(false) @map("can_update_tasks")
  canUpdateShipments Boolean      @default(false) @map("can_update_shipments")
  canUpdateFinances Boolean       @default(false) @map("can_update_finances")
  canUpdateMaritimeQuotes Boolean @default(false) @map("can_update_maritime_quotes")
  canUpdateMural    Boolean       @default(false) @map("can_update_mural")
  canDeleteMessages Boolean       @default(false) @map("can_delete_messages")
  canDeleteIdeas    Boolean       @default(false) @map("can_delete_ideas")
  canDeleteRoutes   Boolean       @default(false) @map("can_delete_routes")
  canDeleteRouteLogs Boolean      @default(false) @map("can_delete_route_logs")
  canDeleteUnitTypes Boolean      @default(false) @map("can_delete_unit_types")
  canDeleteQuotes   Boolean       @default(false) @map("can_delete_quotes")
  canDeleteProviders Boolean      @default(false) @map("can_delete_providers")
  canDeleteClients  Boolean       @default(false) @map("can_delete_clients")
  canDeleteEmployees Boolean      @default(false) @map("can_delete_employees")
  canDeleteVendors  Boolean       @default(false) @map("can_delete_vendors")
  canDeleteLaptops  Boolean       @default(false) @map("can_delete_laptops")
  canDeletePhones   Boolean       @default(false) @map("can_delete_phones")
  canDeleteEmails   Boolean       @default(false) @map("can_delete_emails")
  canDeleteTasks    Boolean       @default(false) @map("can_delete_tasks")
  canDeleteShipments Boolean      @default(false) @map("can_delete_shipments")
  canDeleteFinances Boolean       @default(false) @map("can_delete_finances")
  canDeleteMaritimeQuotes Boolean @default(false) @map("can_delete_maritime_quotes")
  canDeleteMural    Boolean       @default(false) @map("can_delete_mural")
  canCreateRecords  Boolean       @default(false) @map("can_create_records")
  canReadRecords    Boolean       @default(false) @map("can_read_records")
  canUpdateRecords  Boolean       @default(false) @map("can_update_records")
  canDeleteRecords  Boolean       @default(false) @map("can_delete_records")
  whatsappPhone  String?        @map("whatsapp_phone")
  onboardingTourCompletedAt DateTime? @map("onboarding_tour_completed_at")
  /// Baja laboral. No se borra a la persona: sus checadas y su expediente son
  /// justo lo que respalda la baja. Con fecha aquí, no puede entrar y deja de
  /// salir en las listas activas.
  offboardedOn      DateTime? @db.Date @map("offboarded_on")
  offboardReason    String?   @map("offboard_reason")
  offboardedByName  String?   @map("offboarded_by_name")
  createdAt     DateTime       @map("created_at")
  updatedAt     DateTime       @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  profile          Profile?
  carrierRoutes    CarrierRoute[]
  carrierSuggestions CarrierSuggestion[]
  employeeProfile  EmployeeProfile?
  ownedCollaborators EmployeeProfile[] @relation("CollaboratorOwner")
  assignedLaptops  Laptop[]
  assignedPhones   Phone[]
  assignedEmails   EmailAccountUser[]
  maintenances     Maintenance[]   @relation("MaintenanceTechnician")
  supportTickets   SupportTicket[] @relation("TicketReporter")
  timeClockEntries TimeClockEntry[]
  workSchedules    WorkSchedule[]
  timeClockIncidents TimeClockIncident[]
  timeClockCorrections TimeClockEntry[] @relation("TimeClockCorrector")
  leaves               TimeClockLeave[] @relation("LeaveOwner")
  leavesCreated        TimeClockLeave[] @relation("LeaveAuthor")
  prospects            ProviderProspect[] @relation("ProspectAuthor")
  onboardings          ProviderOnboarding[] @relation("OnboardingAuthor")
  clientLeadsOwned     ClientLead[] @relation("ClientLeadOwner")
  clientLeadsCreated   ClientLead[] @relation("ClientLeadAuthor")
  clientLeadActivities ClientLeadActivity[] @relation("ClientLeadActivityAuthor")
  billingDocuments     BillingDocument[] @relation("BillingDocumentAuthor")
  /// Días en que JTP le paga al transportista (lo pone JTP, no el transportista).
  /// Con ellos vence su cuenta por pagar; vacío = 30 días.
  carrierPaymentDays   Int?              @map("carrier_payment_days")
  billingAttachments   BillingAttachment[] @relation("BillingAttachmentAuthor")
  billingCreditNotes   BillingCreditNote[] @relation("BillingCreditNoteAuthor")
  billingPayments      BillingPayment[]  @relation("BillingPaymentAuthor")
  expenses             Expense[]         @relation("ExpenseAuthor")
  bankMovements        BankMovement[]    @relation("BankMovementAuthor")

  /// Usuario que un proveedor (transportista) da de alta para su empresa.
  /// Conserva el rol carrier para entrar al mismo panel, pero trabaja sobre
  /// los datos de su usuario principal: tarifas, mensajes y perfil de la
  /// empresa están amarrados al id del principal, no al suyo.
  parentCarrierId      String?   @map("parent_carrier_id")
  parentCarrier        User?     @relation("CarrierMembers", fields: [parentCarrierId], references: [id], onDelete: Cascade)
  carrierMembers       User[]    @relation("CarrierMembers")
  fleetVehicles        CarrierVehicle[]  @relation("CarrierFleet")
  fleetOperators       CarrierOperator[] @relation("CarrierOperators")
  /// Lo que el principal le permite. El principal no usa estas columnas: lo
  /// puede todo en su empresa.
  memberCanViewRates   Boolean   @default(false) @map("member_can_view_rates")
  memberCanEditRates   Boolean   @default(false) @map("member_can_edit_rates")
  memberCanMessage     Boolean   @default(false) @map("member_can_message")
  memberCanSuggest     Boolean   @default(false) @map("member_can_suggest")
  memberCanEditCompany Boolean   @default(false) @map("member_can_edit_company")
  /// Se le quitó el acceso. No se borra el usuario: sus mensajes a JTP se
  /// borrarían en cascada y la conversación de la empresa perdería registro.
  memberRevokedAt      DateTime? @map("member_revoked_at")
  ideas            Idea[]
  createdRoutes    Route[]        @relation("RouteCreatedBy")
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskCreator")
  generatedQuotes  GeneratedQuote[]
  quoteComments    QuoteComment[]
  maritimeQuotes   MaritimeQuote[]
  sentMessages     Message[]      @relation("SentMessages")
  carrierMessages  Message[]      @relation("CarrierMessages")
  notifications    Notification[]
  carrierManualRatings CarrierManualRating[] @relation("CarrierRatingRatedBy")
  muralPosts       MuralPost[]    @relation("MuralPostAuthor")
  muralEntries     MuralEntry[]   @relation("MuralEntryAuthor")
  muralMentions    MuralEntry[]   @relation("MuralEntrySubject")

  @@index([parentCarrierId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid()) @map("id")
  expiresAt DateTime @map("expires_at")
  token     String   @unique @map("token")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid()) @map("id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid()) @map("id")
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verifications")
}

// ---- App: routes (admin CRUD), profiles (carrier extra data) ----

enum RouteStatus {
  active
  inactive
  pending
}

model UnitTypeDef {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  value     String   @unique @map("value")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unit_types")
}

model IncidentTypeDef {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  value     String   @unique @map("value")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("incident_types")
}

model Route {
  id               String             @id @default(cuid()) @map("id")
  origin           String             @map("origin")
  destination      String             @map("destination")
  description      String?            @map("description")
  target           Float?             @map("target")
  weeklyVolume     Int?               @map("weekly_volume")
  destinationState String?            @map("destination_state")
  unitType         String             @default("caja_seca") @map("unit_type")
  status           RouteStatus        @default(pending) @map("status")
  /// Vino de una carga masiva (Excel) sin elegir a nombre de quién: se muestra
  /// "Carga masiva" en lugar del nombre de quien la subió.
  bulkImported Boolean      @default(false) @map("bulk_imported")
  createdById      String?            @map("created_by_id")
  createdBy        User?              @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  carrierRoutes    CarrierRoute[]
  clientRoutes     ClientRoute[]
  unitTargets      RouteUnitTarget[]

  @@map("routes")
}

model RouteUnitTarget {
  id       String  @id @default(cuid()) @map("id")
  routeId  String  @map("route_id")
  route    Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  unitType String  @map("unit_type")
  target   Float?  @map("target")

  @@unique([routeId, unitType])
  @@map("route_unit_targets")
}

model CarrierRoute {
  id            String   @id @default(cuid()) @map("id")
  carrierId            String   @map("carrier_id")
  routeId              String   @map("route_id")
  unitType             String   @default("") @map("unit_type")
  carrierTarget        Float?   @map("carrier_target")
  /// Condición pactada con este proveedor para esta ruta; sale en el tarifario.
  terms                String?  @map("terms")
  carrierWeeklyVolume  Int?     @map("carrier_weekly_volume")
  editUnlockRequested  Boolean  @default(false) @map("edit_unlock_requested")
  editUnlockApproved   Boolean  @default(false) @map("edit_unlock_approved")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  carrier       User     @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([carrierId, routeId, unitType])
  @@map("carrier_routes")
}

enum ContactType {
  phone
  email
}

model Profile {
  id             String    @id @default(cuid()) @map("id")
  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commercialName String?   @map("commercial_name")
  legalName      String?   @map("legal_name")
  rfc            String?   @map("rfc")
  address        String?   @map("address")
  contacts       Contact[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

model Contact {
  id         String      @id @default(cuid()) @map("id")
  profileId  String      @map("profile_id")
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       ContactType @map("type")
  value      String      @map("value")
  label      String?     @map("label")
  position   String?     @map("position")
  /** Nombre de la persona de contacto; agrupa teléfonos/correos por persona. */
  personName String?     @map("person_name")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("contacts")
}

// ---- App: clientes (admin CRUD) ----

model Client {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  contactName String? @map("contact_name")
  position  String?  @map("position")
  legalName String?  @map("legal_name")
  rfc       String?  @map("rfc")
  email     String?  @map("email")
  phone     String?  @map("phone")
  address   String?  @map("address")
  notes     String?  @map("notes")
  detentionConditions String? @map("detention_conditions")
  productTypes String[] @default([]) @map("product_types")
  /// Datos para facturar (CFDI 4.0), tal como vienen en su constancia de situación fiscal.
  taxRegime String?  @map("tax_regime")
  fiscalZip String?  @map("fiscal_zip")
  cfdiUse   String?  @map("cfdi_use")
  /// Días de crédito: con ellos se calcula el vencimiento de sus facturas.
  creditDays Int?    @map("credit_days")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  clientRoutes ClientRoute[]
  leads        ClientLead[]
  billingDocuments BillingDocument[]

  @@map("clients")
}

model ClientRoute {
  id           String   @id @default(cuid()) @map("id")
  clientId     String   @map("client_id")
  routeId      String   @map("route_id")
  unitType     String   @default("") @map("unit_type")
  target       Float?   @map("target")
  weeklyVolume Int?     @map("weekly_volume")
  createdAt    DateTime @default(now()) @map("created_at")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([clientId, routeId, unitType])
  @@map("client_routes")
}

// ---- App: log de cambios en rutas (solo admin) ----

model RouteLog {
  id         String   @id @default(cuid()) @map("id")
  routeId    String   @map("route_id")
  routeLabel String   @map("route_label")
  action     String   @map("action")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  changes    String?  @map("changes")
  snapshot   String?  @map("snapshot")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([routeId])
  @@index([createdAt])
  @@map("route_logs")
}

// ---- App: auditoría global de cambios ----

model AuditLog {
  id            String   @id @default(cuid()) @map("id")
  resource      String   @map("resource")
  resourceId    String   @map("resource_id")
  resourceLabel String   @map("resource_label")
  action        String   @map("action")
  userId        String   @map("user_id")
  userName      String   @map("user_name")
  changes       String?  @map("changes")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---- App: mensajería interna (carrier ↔ compras/admin) ----

model Message {
  id         String   @id @default(cuid()) @map("id")
  carrierId  String   @map("carrier_id")
  senderId   String   @map("sender_id")
  senderName String   @map("sender_name")
  senderRole String   @map("sender_role")
  body       String   @map("body")
  createdAt  DateTime @default(now()) @map("created_at")
  carrier    User     @relation("CarrierMessages", fields: [carrierId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([carrierId, createdAt])
  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  type      String   @map("type")
  title     String   @map("title")
  body      String?  @map("body")
  href      String?  @map("href")
  read      Boolean  @default(false) @map("read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ---- App: recursos internos (admin CRUD) ----

model EmployeeProfile {
  id         String  @id @default(cuid()) @map("id")
  userId     String  @unique @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId String? @map("owner_user_id")
